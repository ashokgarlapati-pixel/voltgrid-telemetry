{
  "name": "voltgrid-backend",
  "version": "1.0.0",
  "description": "VoltGrid Fleet Telemetry Service Backend",
  "main": "src/server.js",
  "scripts": {
    "start": "node -e \"process.env.NODE_ENV = process.env.NODE_ENV || 'development'; require('./src/server.js')\"",
    "start:prod": "node src/server.js",
    "dev": "node -e \"process.env.NODE_ENV='development'; require('./src/server.js')\"",
    "test": "node --test --test-reporter=spec tests/*.test.js",
    "test:coverage": "node --experimental-test-coverage --test tests/*.test.js",
    "test:unit": "node --test tests/alerts.unit.test.js",
    "test:concurrency": "node --test tests/concurrency*.test.js",
    "simulate": "node ../simulator/simulator.js",
    "loadtest": "node ../scripts/loadtest.js",
    "benchmark:5m": "node ../scripts/benchmark_5m.js",
    "benchmark:summary": "node ../scripts/benchmark_5m.js",
    "benchmark:17k": "node ../scripts/benchmark_history_17k.js",
    "benchmark:history": "node ../scripts/benchmark_history_17k.js"
  },
  "dependencies": {
    "express": "^4.21.2"
  },
  "optionalDependencies": {
    "better-sqlite3": "^11.8.1"
  }
}
