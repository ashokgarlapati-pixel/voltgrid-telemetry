# ==============================================================================
# VoltGrid Telemetry Service - Environment Configuration Example
# ==============================================================================

# Node Environment: production | development | test
# When set to production, development credentials ('voltgrid-dev-key') are
# strictly rejected and purged. Valid production credentials MUST be supplied.
NODE_ENV=production

# API Server Port
PORT=3000

# SQLite Database Storage File
DB_PATH=/data/voltgrid.db

# ------------------------------------------------------------------------------
# Production HMAC Credentials (Required in production)
# ------------------------------------------------------------------------------
# Set a unique API key and a high-entropy secret (minimum 16 characters).
# NEVER commit real production secrets to version control.
API_KEY=voltgrid-fleet-ops
API_SECRET=replace-with-a-high-entropy-production-secret-min32chars

# Per-key rate limiting (Optional overrides)
API_RATE_LIMIT=20
API_BURST_CAPACITY=40

# ------------------------------------------------------------------------------
# Multiple Device Group Keys (Alternative to API_KEY / API_SECRET)
# ------------------------------------------------------------------------------
# VOLTGRID_API_KEYS=[{"api_key":"fleet-east","secret":"high-entropy-secret-east-32chars","rate_limit_per_sec":30,"burst_capacity":60},{"api_key":"fleet-west","secret":"high-entropy-secret-west-32chars","rate_limit_per_sec":30,"burst_capacity":60}]
